# ====================================================================
# concilia — variaveis de ambiente
# Copie este arquivo para .env (na raiz do monorepo) e preencha.
# ====================================================================

# --- Supabase ---
# Pegue em https://supabase.com -> seu projeto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Postgres (Supabase) ---
# Settings -> Database -> Connection string
# Pooled (porta 6543) para o app em runtime:
DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
# Direct (porta 5432) para drizzle-kit migrate/push:
DATABASE_URL_DIRECT=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cielo (checkout de reserva) ---
CIELO_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CIELO_MERCHANT_KEY=...

# ---- Rede / Itaú — e.Rede (cobrança ONLINE: Pix + cartão) ----
# Fallback global; o normal é cadastrar por filial em Configurações → Pagamento
# (card "Rede (e.Rede)"), cifrado no banco. Pix pela Rede exige conta Itaú.
REDE_PV=                     # nº de filiação (vira clientId no OAuth)
REDE_CHAVE_INTEGRACAO=       # gerada no Portal Use Rede (e-commerce → chave de integração) = clientSecret
REDE_SOFT_DESCRIPTOR=PRAINHA # texto na fatura (até 18, sem acento)
REDE_SANDBOX=                # 'true' = usa as URLs de sandbox (GLOBAL — só enquanto nenhuma loja real usa Rede)
REDE_WEBHOOK_SECRET=         # opcional: exigido no header authorization do POST /api/webhook/rede
