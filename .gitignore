# Scripts avulsos de teste/depuração — nome "tmp" já diz que é descartável
vendas-local/tmp-*.mjs

# Scripts pontuais de acesso direto ao Firebird das lojas: têm host/caminho
# do .fdb junto com o padrão de conexão. Ficam fora de propósito (ver memória
# consumer-firebird-acesso-remoto) — não por segredo real (usam
# SYSDBA/masterkey, padrão de fábrica do Firebird), mas por serem scripts
# pontuais de acesso operacional, não parte do produto.
agente-local/cardapio-tabuara.mjs
agente-local/cardapio-dev.mjs
agente-local/dump-cardapio-json.mjs

# Artefato de runtime do auto-update (vendas-local/auto-update.ps1): o
# servidor baixa a versão nova aqui antes de trocar. Só existe nas lojas
# (Windows) — se aparecer aqui é lixo de teste local, nunca é pra commitar.
vendas-local/server.novo.mjs
