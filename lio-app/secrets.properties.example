# Modelo de lio-app/secrets.properties — copie pra "secrets.properties" e preencha.
# O arquivo real é gitignorado; NUNCA commitar valores.

# Servidor default do app = vendas-local da loja (HTTP :8790 na LAN).
# O app permite trocar de servidor na tela de login (Prainha/Tabuará/custom).
API_BASE=http://10.0.0.252:8790

# Dev Console Cielo (desenvolvedores.cielo.com.br) -> Cadastrar Nova App ->
# credenciais Client ID / Access Token. OBRIGATÓRIAS pro pagamento na
# maquininha (sem elas o botão de cobrar não existe no APK e a certificação
# reprova — foi reprovação real no CupomPro).
# (só o build cielo usa; o build rede ignora — ./build-release.sh rede)
CIELO_CLIENT_ID=
CIELO_ACCESS_TOKEN=

# Assinatura do APK release. Usar SEMPRE a mesma keystore em toda versão
# (a Cielo Store rejeita update com assinatura diferente). A keystore do
# Concilia é ~/concilia-lio-release.keystore (alias "concilia") — faça
# BACKUP dela e da senha; perder = nunca mais atualizar o app.
KEYSTORE_FILE=~/concilia-lio-release.keystore
KEYSTORE_PASSWORD=
KEY_ALIAS=concilia
KEY_PASSWORD=
