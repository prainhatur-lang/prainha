<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0C7091"
        android:padding="10dp">

        <Button
            android:id="@+id/voltarProdutos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="‹ Conta"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tituloProdutos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <EditText
        android:id="@+id/busca"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_margin="8dp"
        android:hint="🔍 Buscar no cardápio"
        android:inputType="textNoSuggestions"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/produtosVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="18dp"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listaProdutos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp"
        android:background="#FFFFFF" />

    <!-- Carrinho -->
    <LinearLayout
        android:id="@+id/carrinhoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#111827"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/carrinhoTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingStart="6dp" />

        <Button
            android:id="@+id/enviar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="ENVIAR"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#15803D" />
    </LinearLayout>
</LinearLayout>
