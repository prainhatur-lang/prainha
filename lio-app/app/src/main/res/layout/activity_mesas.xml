<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- Cabeçalho em 3 linhas (02/11/2026): os botões ficavam ao lado do nome
         e espremiam loja/garçom em 5 linhas quebradas.
         1) loja + Sair · 2) garçom · conexão · versão · 3) Entregas / 🎟 Ticket / Fechar o dia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0C7091"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="Concilia" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- nome do sistema, pedido do dono 02/11/2026 -->
                <TextView
                    android:id="@+id/sistemaNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONCILIA GARÇOM"
                    android:letterSpacing="0.08"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#9FD3E3" />

                <TextView
                    android:id="@+id/lojaNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <Button
                android:id="@+id/sair"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_cabecalho"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:text="Sair"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/garcomNome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="#E0F2F7" />

            <TextView
                android:id="@+id/rota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:textColor="#E0F2F7" />

            <TextView
                android:id="@+id/versao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="#9FD3E3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/entregas"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_cabecalho"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:text="🛵 Entregas"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 🎟 Ticket subiu pra cá a pedido do dono (02/11/2026) -->
            <Button
                android:id="@+id/venderTicket"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_ticket"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="🎟 Ticket"
                android:textSize="13sp" />

            <Button
                android:id="@+id/fechamentoDia"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_cabecalho"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:text="🧾 Fechar o dia"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Só na demo (/api/config conheca_url): site de venda do Concilia -->
        <Button
            android:id="@+id/conhecaSistema"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_cabecalho"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="🌐 Conheça o sistema completo"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Baixas pendentes (pagamento capturado sem registro) -->
    <TextView
        android:id="@+id/pendentes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:textColor="#92400E"
        android:textSize="13sp"
        android:padding="10dp"
        android:visibility="gone" />

    <!-- Abrir mesa pelo número -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/numero"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Nº da mesa ou comanda"
            android:textSize="17sp"
            android:inputType="number"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/abrir"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="Abrir"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:background="#0C7091" />

    </LinearLayout>

    <TextView
        android:id="@+id/listaVazia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="18dp"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:visibility="gone" />

    <GridView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:horizontalSpacing="6dp"
        android:verticalSpacing="6dp"
        android:padding="8dp"
        android:clipToPadding="false" />
</LinearLayout>
