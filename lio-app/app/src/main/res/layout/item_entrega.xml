<?xml version="1.0" encoding="utf-8"?>
<!-- Uma entrega na fila do entregador: quem/onde, valor e estado do pagamento,
     itens, e os botões da rota (saí / cheguei / entregue) e do recebimento na
     porta (maquininha / dinheiro). O adapter esconde o que não se aplica. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:padding="12dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#111827" />

    <TextView
        android:id="@+id/endereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="#374151" />

    <TextView
        android:id="@+id/fone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="#0C7091" />

    <TextView
        android:id="@+id/valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#111827" />

    <TextView
        android:id="@+id/itens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#4B5563" />

    <TextView
        android:id="@+id/rota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#6B7280" />

    <!-- rota -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/saiu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="🛵 Saí"
            android:textSize="12sp" />

        <Button
            android:id="@+id/cheguei"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="🔔 Cheguei"
            android:textSize="12sp" />

        <Button
            android:id="@+id/entregue"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="✅ Entregue"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- recebimento na porta (só "pagar na entrega") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/receber"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#0C7091"
            android:textColor="#FFFFFF"
            android:text="💳 Receber"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dinheiro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="💵 Dinheiro"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
