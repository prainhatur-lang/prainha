<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:minHeight="480dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_logo"
            android:layout_marginBottom="10dp"
            android:contentDescription="Prainha" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concilia Garçom"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0C7091" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="venda e recebimento na maquininha"
            android:textSize="13sp"
            android:textColor="#6B7280" />

        <Spinner
            android:id="@+id/servidor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/descobertaStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#0C7091"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/servidorCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://servidor-da-loja"
            android:inputType="textUri"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Login (o mesmo do Consumer)"
            android:inputType="textNoSuggestions"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN (4 a 8 números)"
            android:inputType="numberPassword"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/pin2Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primeiro acesso — confirme o PIN:"
            android:textSize="13sp"
            android:textColor="#0C7091"
            android:visibility="gone" />

        <EditText
            android:id="@+id/pin2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Repita o PIN"
            android:inputType="numberPassword"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/erro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/entrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Entrar"
            android:textColor="#FFFFFF"
            android:background="#0C7091" />

        <TextView
            android:id="@+id/versaoApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>
</ScrollView>
